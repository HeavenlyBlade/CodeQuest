@page "/battle/{ChallengeId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject GameService GameSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@using CodeQuest.Data
@inject GameDbContext Db
@using Microsoft.EntityFrameworkCore

<PageTitle>Battle – CodeQuest</PageTitle>

@if (_loading)
{
    <div class="panel text-center mt-5">
        <p>Entering the battle arena...</p>
    </div>
}
else if (_player == null)
{
    <p class="text-danger">Player not found.</p>
}
else if (_battle == null)
{
    <p class="text-danger">Battle could not start.</p>
}
else
{
    <!-- Battle status: Victory -->
    @if (_battle.Status == BattleStatus.Won)
    {
        <div class="panel text-center animate-scale-in">
            <h2 style="font-family:var(--font-heading);color:var(--color-gold);">Victory Achieved!</h2>
            <p>You conquered <strong>@_challenge?.MonsterName</strong>!</p>
            <div class="p-3 my-3 rounded" style="background:rgba(245,166,35,0.1);border:1px solid rgba(245,166,35,0.3);max-width:400px;margin:0 auto;">
                <div class="small text-muted mb-1">Clear Time: @FormatDuration(_battleDuration)</div>
                @if (_lastResult != null && _lastResult.XpGained > 0)
                {
                    <div class="gold-text fs-5">
                        +@_lastResult.XpGained XP &nbsp; +@_lastResult.GoldGained Gold
                    </div>
                    @if (_lastResult.LeveledUp)
                    {
                        <div class="text-success mt-2 fw-bold">Level Up! You are now Level @_lastResult.NewLevel!</div>
                    }
                }
                else
                {
                    <div class="text-muted small">(Replayed Battle — Practice Only)</div>
                }
            </div>
            @if (_nextLesson != null)
            {
                <a href="/lesson/@_nextLesson.Id" class="btn-fantasy mt-2">Next: @_nextLesson.Title</a>
            }
            <a href="/zone/@(_challenge?.ZoneId)" class="btn btn-outline-secondary ms-2 mt-2">Back to Zone</a>
        </div>
    }
    <!-- Battle status: Defeat -->
    else if (_battle.Status == BattleStatus.Lost)
    {
        <div class="panel text-center animate-fade-in-up">
            @if (_defeatReason == "retreat")
            {
                <h2>Tactical Retreat!</h2>
                <p>You were unable to defeat <strong>@_challenge?.MonsterName</strong>.</p>
                <p class="muted-text">Review the lesson material to strengthen your code knowledge!</p>
                @if (_challenge?.LessonId != null)
                {
                    <a href="/lesson/@_challenge.LessonId" class="btn-fantasy mt-3">Re-learn Lesson</a>
                }
                <a href="/zone/@(_challenge?.ZoneId)" class="btn btn-outline-secondary ms-2 mt-3">Back to Zone</a>
            }
            else
            {
                <h2 class="text-danger">Defeated!</h2>
                <p>You fell before <strong>@_challenge?.MonsterName</strong>. Your HP has been restored.</p>
                <button class="btn-fantasy mt-3" @onclick="TryAgain">Try Again</button>
                <a href="/zone/@(_challenge?.ZoneId)" class="ms-3 btn btn-outline-secondary mt-3">Back to Zone</a>
            }
        </div>
    }
    <!-- Battle in progress -->
    else
    {
        <!-- Header & Timers HUD -->
        <div class="battle-timers-bar">
            <div class="timer-pill">
                <span>Total Battle:</span>
                <span class="gold-text font-monospace">@FormatDuration(_battleDuration)</span>
            </div>
            <div class="timer-pill @(_questionSecondsLeft <= 15 ? "urgent" : "")">
                <span>Turn Timer:</span>
                <span class="font-monospace">@_questionSecondsLeft s</span>
            </div>
        </div>

        <!-- Pokemon-Style Battle Arena Stage -->
        <div class="pokemon-arena @(_isDragon ? "dragon-intro-shake" : "")">
            <div class="pokemon-stage">
                <!-- TOP-RIGHT: Opponent Monster Platform & Status Plate -->
                <div class="pokemon-opponent-row">
                    <!-- Status Plate -->
                    <div class="pokemon-plate pokemon-plate-opponent">
                        <div class="pokemon-plate-header">
                            <h4 class="pokemon-name">@_challenge?.MonsterName</h4>
                            <span class="pokemon-level">Lv.@(_challenge?.OrderNumber * 2 ?? 1)</span>
                        </div>
                        <div class="pokemon-hp-track">
                            <div class="pokemon-hp-fill @GetHpClass(MonsterHpPercent)" style="width:@MonsterHpPercent%;"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted" style="font-size:0.75rem;">
                            <span>HP</span>
                            <span>@_battle.MonsterHpLeft / @_challenge?.MonsterHp</span>
                        </div>
                    </div>

                    <!-- Platform & Sprite -->
                    <div class="pokemon-monster-platform">
                        @if (MonsterSpritePath != null)
                        {
                            <img src="@MonsterSpritePath" alt="@_challenge?.MonsterName" class="pokemon-monster-sprite" />
                        }
                        else
                        {
                            <div style="font-size:3rem;line-height:1;z-index:2;">👾</div>
                        }
                        <div class="pokemon-shadow"></div>
                    </div>
                </div>

                <!-- BOTTOM-LEFT: Hero Player Platform & Status Plate -->
                <div class="pokemon-player-row">
                    <!-- Platform & Avatar -->
                    <div class="pokemon-hero-platform">
                        <div class="pokemon-hero-avatar">
                            &#9876;
                        </div>
                        <div class="pokemon-shadow" style="width:75px;"></div>
                    </div>

                    <!-- Status Plate -->
                    <div class="pokemon-plate pokemon-plate-hero">
                        <div class="pokemon-plate-header">
                            <h4 class="pokemon-name">@_player.HeroName</h4>
                            <span class="pokemon-level">Lv.@_player.Level</span>
                        </div>
                        <div class="pokemon-hp-track">
                            <div class="pokemon-hp-fill @GetHpClass(PlayerHpPercent)" style="width:@PlayerHpPercent%;"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted" style="font-size:0.75rem;">
                            <span>HP</span>
                            <span>@_player.CurrentHp / @_player.MaxHp</span>
                        </div>
                        <div class="pokemon-exp-track">
                            <div class="pokemon-exp-fill" style="width:@PlayerExpPercent%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pokemon Retro Dialogue / Feedback Box -->
        <div class="pokemon-dialogue">
            @if (_showFeedback && _lastResult != null)
            {
                @if (_lastResult.IsCorrect)
                {
                    <div class="text-success fw-bold">Critical Strike! You answered correctly!</div>
                    <div>You dealt <strong>@_lastResult.DamageToMonster damage</strong> to @_challenge?.MonsterName!</div>
                    @if (!string.IsNullOrEmpty(_lastResult.ActionFeedback))
                    {
                        <div class="gold-text small mt-1">@_lastResult.ActionFeedback</div>
                    }
                }
                else
                {
                    <div class="text-danger fw-bold">Missed! The monster countered!</div>
                    <div>The monster dealt <strong>@_lastResult.DamageToPlayer damage</strong> to you!</div>
                    @if (!string.IsNullOrEmpty(_lastResult.ActionFeedback))
                    {
                        <div class="text-info small mt-1">@_lastResult.ActionFeedback</div>
                    }
                    <div class="text-muted small mt-1">Correct Answer: @_lastResult.CorrectAnswer</div>
                }

                @if (_battle.Status == BattleStatus.InProgress)
                {
                    <div class="mt-2">
                        <button class="btn-fantasy btn-sm" @onclick="LoadNextQuestion">Next Question &rarr;</button>
                    </div>
                }
            }
            else
            {
                <div>What will <strong>@_player.HeroName</strong> do? Choose a combat stance and solve the code puzzle!</div>
            }
        </div>

        @if (!_showFeedback && _currentQuestion != null)
        {
            <!-- Question & Code Workspace -->
            <div class="panel mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 style="margin:0;color:var(--color-gold);">Battle Challenge</h5>
                    <span class="badge bg-secondary">@_currentQuestion.Difficulty</span>
                </div>
                <p style="white-space:pre-wrap;font-size:0.95rem;">@_currentQuestion.Text</p>

                <!-- 3 Pre-Programming Combat Actions (Stances) -->
                <div class="mb-3">
                    <div class="small text-muted mb-1 fw-bold">SELECT COMBAT STANCE:</div>
                    <div class="pokemon-actions-bar">
                        <div class="action-stance-card @(_selectedAction == "Attack" ? "active" : "")"
                             @onclick='() => SelectAction("Attack")'>
                            <div class="stance-title text-danger">
                                <span>&#9876;</span> Attack Stance
                            </div>
                            <div class="stance-desc">50-100% Crit Chance (up to +10 bonus DMG)</div>
                        </div>

                        <div class="action-stance-card @(_selectedAction == "Parry" ? "active parry" : "")"
                             @onclick='() => SelectAction("Parry")'>
                            <div class="stance-title text-info">
                                <span>&#9969;</span> Parry Stance
                            </div>
                            <div class="stance-desc">Deflect 20% monster counterattack back</div>
                        </div>

                        <div class="action-stance-card @(_selectedAction == "Defend" ? "active defend" : "")"
                             @onclick='() => SelectAction("Defend")'>
                            <div class="stance-title text-warning">
                                <span>&#9670;</span> Defend Stance
                            </div>
                            <div class="stance-desc">Nullify 30-50% damage if incorrect</div>
                        </div>
                    </div>
                </div>

                @if (_currentQuestion.Type == ChallengeType.MultipleChoice)
                {
                    <!-- Multiple choice hints and quick selection -->
                    <div class="mb-2">
                        <div class="small text-muted mb-1">Answer Choices (write output or code in editor, or pick directly):</div>
                        <div class="row g-2 mb-2">
                            @foreach (var (letter, text) in GetChoices())
                            {
                                <div class="col-md-6">
                                    <div class="p-2 rounded"
                                         style="background:rgba(255,255,255,0.04);border:1px solid @(_answer == letter ? "var(--color-accent)" : "rgba(255,255,255,0.1)");cursor:pointer;"
                                         @onclick="() => SetChoiceAnswer(letter)">
                                        <strong>@letter:</strong> @text
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Monaco Code Editor for All Challenges -->
                <div class="mt-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted">C# Code Workspace:</span>
                        <button class="btn btn-sm btn-outline-info" @onclick="RunCodeTests" disabled="@_running">
                            @(_running ? "Running…" : "▶ Run Code")
                        </button>
                    </div>

                    <div id="monaco-editor-@_battle.Id"
                         style="height:260px; border:1px solid #444; border-radius:6px; margin-bottom:0.5rem;">
                    </div>

                    @if (_testOutput is not null)
                    {
                        <div class="mt-2 code-block p-2 rounded" style="font-size:0.85rem; white-space:pre-wrap; background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.1);">
                            @_testOutput
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_validationMsg))
                {
                    <p class="text-warning mt-2">@_validationMsg</p>
                }

                <div class="mt-3 d-flex gap-2">
                    <button class="btn-fantasy" @onclick="SubmitAnswer" disabled="@_submitting">
                        @(_submitting ? "Striking..." : $"⚔️ Execute {_selectedAction} & Submit")
                    </button>
                </div>
            </div>
        }
        else if (_currentQuestion == null && !_showFeedback)
        {
            <div class="panel">
                <p>No more questions available. The monster retreats!</p>
            </div>
        }
    }
}

@code {
    [Parameter] public int ChallengeId { get; set; }

    private Player? _player;
    private Battle? _battle;
    private Challenge? _challenge;
    private Question? _currentQuestion;
    private GameService.AnswerResult? _lastResult;
    private string _answer = "";
    private string _selectedAction = "Attack";
    private string _validationMsg = "";
    private bool _loading = true;
    private bool _submitting;
    private bool _showFeedback;
    private bool _noQuestions;
    private string _defeatReason = "";
    private Lesson? _nextLesson;
    private bool _isDragon;

    // Timers
    private System.Threading.Timer? _timer;
    private int _questionSecondsLeft = 60;
    private TimeSpan _battleDuration = TimeSpan.Zero;
    private DateTime _turnStartTime = DateTime.UtcNow;

    // Monaco editor state
    private bool _editorInitialized = false;
    private bool _running = false;
    private string? _testOutput = null;

    private int MonsterHpPercent => _battle == null || _challenge == null || _challenge.MonsterHp == 0 ? 0
        : Math.Clamp((int)((double)_battle.MonsterHpLeft / _challenge.MonsterHp * 100), 0, 100);

    private int PlayerHpPercent => _player == null || _player.MaxHp == 0 ? 0
        : Math.Clamp((int)((double)_player.CurrentHp / _player.MaxHp * 100), 0, 100);

    private int PlayerExpPercent => _player == null ? 0
        : Math.Clamp((int)((double)_player.Xp / (_player.Level * 50) * 100), 0, 100);

    private static readonly (string keyword, string path)[] _spriteKeywords =
    {
        ("slime",        "/images/monsters/slime.gif"),
        ("goblin",       "/images/monsters/goblin.gif"),
        ("troll",        "/images/monsters/stone-troll.gif"),
        ("specter",      "/images/monsters/echo-specter.gif"),
        ("wisp",         "/images/monsters/logic-wisp.gif"),
        ("mimic",        "/images/monsters/cave-mimic.gif"),
        ("golem",        "/images/monsters/iron-golem.gif"),
        ("doppelganger", "/images/monsters/shadow-doppelganger.gif"),
        ("phantom",      "/images/monsters/twin-phantoms.gif"),
        ("dragon",       "/images/monsters/variable-dragon.gif"),
    };

    private string? MonsterSpritePath =>
        _challenge == null ? null :
        _spriteKeywords
            .FirstOrDefault(s => _challenge.MonsterName.Contains(s.keyword, StringComparison.OrdinalIgnoreCase))
            .path;

    private string GetHpClass(int percent) => percent switch
    {
        > 50 => "hp-high",
        > 20 => "hp-mid",
        _ => "hp-low"
    };

    private string FormatDuration(TimeSpan ts) => $"{(int)ts.TotalMinutes:00}:{ts.Seconds:00}";

    private void SelectAction(string action)
    {
        _selectedAction = action;
    }

    private async Task SetChoiceAnswer(string letter)
    {
        _answer = letter;
        if (_battle != null)
        {
            try
            {
                await JS.InvokeVoidAsync("monacoInterop.setValue", $"monaco-editor-{_battle.Id}", $"// Selected Answer Option: {letter}\nConsole.WriteLine(\"{letter}\");");
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _player = await GameSvc.GetCurrentPlayerAsync();
        if (_player == null) { _loading = false; return; }

        _challenge = await Db.Challenges.FindAsync(ChallengeId);
        _battle = await GameSvc.StartOrResumeBattleAsync(ChallengeId, _player.Id);

        _isDragon = _challenge != null && (_challenge.IsBoss || _challenge.MonsterName.Contains("dragon", StringComparison.OrdinalIgnoreCase));

        if (_battle.Status == BattleStatus.InProgress)
        {
            await LoadQuestion();
            StartTimers();
        }

        if (_battle.Status == BattleStatus.Won && _challenge != null)
            await LoadNextLessonAsync();

        _loading = false;
    }

    private void StartTimers()
    {
        _questionSecondsLeft = 60;
        _turnStartTime = DateTime.UtcNow;
        _timer?.Dispose();
        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                if (_battle == null || _battle.Status != BattleStatus.Won && _battle.Status != BattleStatus.Lost)
                {
                    _battleDuration = DateTime.UtcNow - _battle!.StartedAt;
                    if (!_showFeedback && _questionSecondsLeft > 0)
                    {
                        _questionSecondsLeft--;
                        if (_questionSecondsLeft <= 0)
                        {
                            // Question timeout penalty!
                            _answer = "TIMEOUT_EXPIRED";
                            await SubmitAnswer();
                        }
                    }
                    StateHasChanged();
                }
            });
        }, null, 1000, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("soundInterop.preload", "battle-start",    "/sounds/battle-start.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "answer-correct",  "/sounds/answer-correct.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "answer-wrong",    "/sounds/answer-wrong.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "monster-hit",     "/sounds/monster-hit.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "player-hit",      "/sounds/player-hit.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "monster-defeat",  "/sounds/monster-defeat.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "player-defeat",   "/sounds/player-defeat.mp3");
            await JS.InvokeVoidAsync("soundInterop.preload", "level-up",        "/sounds/level-up.mp3");

            await JS.InvokeVoidAsync("soundInterop.startTheme", "/sounds/battle-theme.mp3");
            await JS.InvokeVoidAsync("soundInterop.play", "battle-start");
        }

        // Initialize Monaco editor for ALL challenges
        if (_currentQuestion != null && _battle != null && !_editorInitialized && !_showFeedback)
        {
            _editorInitialized = true;
            string starter;
            if (!string.IsNullOrWhiteSpace(_currentQuestion.StarterCode))
            {
                starter = _currentQuestion.StarterCode;
            }
            else if (_currentQuestion.Type == ChallengeType.MultipleChoice)
            {
                starter = "// Choose A, B, C, or D\nConsole.WriteLine(\"A\");\n";
            }
            else if (_currentQuestion.Type == ChallengeType.PredictOutput)
            {
                starter = "// Predict output and print it below:\nConsole.WriteLine(\"...\");\n";
            }
            else
            {
                starter = "// Write your C# code here\n";
            }

            try
            {
                await JS.InvokeVoidAsync("monacoInterop.init", $"monaco-editor-{_battle.Id}", "csharp", starter);
            }
            catch { }
        }
    }

    private async Task LoadQuestion()
    {
        var result = await GameSvc.GetCurrentQuestionAsync(_battle!.Id);
        _currentQuestion = result.Question;
        _noQuestions = result.NoQuestionsLeft;

        if (_noQuestions)
        {
            _battle = await Db.Battles.FindAsync(_battle!.Id) ?? _battle;
            _defeatReason = "retreat";
        }
        else
        {
            _questionSecondsLeft = 60;
            _editorInitialized = false;
        }
    }

    private async Task LoadNextQuestion()
    {
        _showFeedback = false;
        _answer = "";
        _validationMsg = "";
        _lastResult = null;
        _editorInitialized = false;
        _testOutput = null;
        _questionSecondsLeft = 60;

        if (_player != null)
            _player = await Db.Players.FindAsync(_player.Id) ?? _player;

        _battle = await Db.Battles.FindAsync(_battle!.Id) ?? _battle;

        if (_battle.Status == BattleStatus.InProgress)
            await LoadQuestion();
    }

    private async Task SubmitAnswer()
    {
        if (_submitting || _player == null || _battle == null) return;

        // Extract code from Monaco editor
        try
        {
            var editorCode = await JS.InvokeAsync<string>("monacoInterop.getValue", $"monaco-editor-{_battle.Id}");
            if (!string.IsNullOrWhiteSpace(editorCode))
            {
                _answer = editorCode;
            }
        }
        catch { }

        if (string.IsNullOrWhiteSpace(_answer))
        {
            _validationMsg = "Please write or enter your solution before submitting.";
            return;
        }

        _validationMsg = "";
        _submitting = true;

        _lastResult = await GameSvc.SubmitAnswerAsync(_battle.Id, _player.Id, _answer, _selectedAction);
        _showFeedback = true;

        if (_lastResult.IsCorrect)
        {
            await JS.InvokeVoidAsync("soundInterop.play", "answer-correct");
            await JS.InvokeVoidAsync("soundInterop.play", "monster-hit");
        }
        else
        {
            await JS.InvokeVoidAsync("soundInterop.play", "answer-wrong");
            await JS.InvokeVoidAsync("soundInterop.play", "player-hit");
        }

        _battle = await Db.Battles.FindAsync(_battle.Id) ?? _battle;
        _player = await Db.Players.FindAsync(_player.Id) ?? _player;

        if (_battle.Status == BattleStatus.Won && _challenge != null)
        {
            _timer?.Dispose();
            await LoadNextLessonAsync();
            await JS.InvokeVoidAsync("soundInterop.stopTheme");
            await JS.InvokeVoidAsync("soundInterop.play", "monster-defeat");
            if (_lastResult.LeveledUp)
                await JS.InvokeVoidAsync("soundInterop.play", "level-up");
        }

        if (_battle.Status == BattleStatus.Lost)
        {
            _timer?.Dispose();
            _defeatReason = _lastResult.DefeatReason == "retreat" ? "retreat" : "";
            await JS.InvokeVoidAsync("soundInterop.stopTheme");
            await JS.InvokeVoidAsync("soundInterop.play", "player-defeat");
        }

        _submitting = false;
    }

    private async Task LoadNextLessonAsync()
    {
        if (_challenge == null) return;
        var currentLesson = _challenge.LessonId.HasValue
            ? await Db.Lessons.FindAsync(_challenge.LessonId.Value)
            : null;
        if (currentLesson != null)
        {
            _nextLesson = await Db.Lessons
                .Where(l => l.ZoneId == _challenge.ZoneId
                         && l.OrderNumber > currentLesson.OrderNumber)
                .OrderBy(l => l.OrderNumber)
                .FirstOrDefaultAsync();
        }
    }

    private void TryAgain()
    {
        _defeatReason = "";
        Nav.NavigateTo($"/battle/{ChallengeId}", forceLoad: true);
    }

    private async Task RunCodeTests()
    {
        if (_running || _battle == null || _currentQuestion == null) return;
        _running = true;
        _testOutput = null;
        StateHasChanged();

        try
        {
            var code = await JS.InvokeAsync<string>("monacoInterop.getValue", $"monaco-editor-{_battle.Id}");
            if (string.IsNullOrWhiteSpace(code))
            {
                _testOutput = "No code in editor to execute.";
                return;
            }

            var results = await GameSvc.RunCodeTestsAsync(_currentQuestion.Id, code);
            _testOutput = results;
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    private IEnumerable<(string Letter, string Text)> GetChoices()
    {
        if (_currentQuestion == null) yield break;
        if (_currentQuestion.ChoiceA != null) yield return ("A", _currentQuestion.ChoiceA);
        if (_currentQuestion.ChoiceB != null) yield return ("B", _currentQuestion.ChoiceB);
        if (_currentQuestion.ChoiceC != null) yield return ("C", _currentQuestion.ChoiceC);
        if (_currentQuestion.ChoiceD != null) yield return ("D", _currentQuestion.ChoiceD);
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        try { await JS.InvokeVoidAsync("soundInterop.stopTheme"); } catch { }

        if (_battle != null)
        {
            try { await JS.InvokeVoidAsync("monacoInterop.dispose", $"monaco-editor-{_battle.Id}"); }
            catch { }
        }
    }
}
