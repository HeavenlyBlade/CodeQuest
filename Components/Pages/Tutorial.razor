@page "/tutorial"
@attribute [Authorize]
@rendermode InteractiveServer
@using CodeQuest.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Nav
@inject GameService GameSvc
@inject GameDbContext Db

<PageTitle>Tutorial – CodeQuest</PageTitle>

<div class="panel animate-fade-in-up" style="max-width:760px;margin:1.5rem auto;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 style="font-family:var(--font-heading);color:var(--color-gold);margin:0;">
            Adventurer's Guide
        </h4>
        <div class="tutorial-step-indicator">Step @_step of @TotalSteps</div>
    </div>

    <div class="tutorial-progress mb-4">
        <div class="tutorial-progress-fill" style="width:@(_step * 100 / TotalSteps)%;"></div>
    </div>

    @if (_step == 1)
    {
        <div class="tutorial-step-card animate-fade-in-up">
            <h2>Welcome, Hero!</h2>
            <p class="lead" style="color:var(--color-teal);font-size:1.05rem;">
                CodeQuest is an RPG designed to help you master C# through story and combat.
            </p>
            <p>
                In this world, ancient code powers the realm. You will read story-based lessons, master concepts, and battle monsters by answering coding challenges.
            </p>
            <div class="tutorial-callout">
                <strong>Combat Core:</strong> Correct answers deal damage to enemies. Wrong answers let monsters counterattack!
            </div>
            <pre style="color:var(--color-accent);background:rgba(0,0,0,0.3);padding:1rem;border-radius:8px;font-family:'Consolas',monospace;font-size:clamp(0.45rem,1.2vw,0.7rem);line-height:1.3;overflow-x:auto;">
   ___         _     ___             _  
  / __|___  __| |___/ _ \ _  _ ___ __| |
 | (__/ _ \/ _` / -_) (_) | || / -_|_-&lt; _|
  \___\___/\__,_\___|\_._\_,_\___/__/\__|</pre>
        </div>
    }
    else if (_step == 2)
    {
        <div class="tutorial-step-card animate-fade-in-up">
            <h2>Zones and Curriculum</h2>
            <p>
                The continent is divided into <strong>Zones</strong>, each focused on a specific C# programming domain.
            </p>
            <p>
                Within each Zone, you progress along a path:
            </p>
            <div class="tutorial-diagram">Zone 1: Variables Valley
  [Lesson 1] The Storage Chests (int, string, bool)
      &#8600; Unlocks Monster 1: Valley Slime
  [Lesson 2] The Goblin's Tricks (naming &amp; assignment)
      &#8600; Unlocks Monster 2: Data Goblin
  ...
  [Lesson 10] Master of Variables
      &#8600; Unlocks Zone Boss: Variable Dragon (BOSS)</div>
            <p class="muted-text mt-2">
                Completing each lesson grants you the knowledge to defeat its paired monster!
            </p>
        </div>
    }
    else if (_step == 3)
    {
        <div class="tutorial-step-card animate-fade-in-up">
            <h2>How Battles Work</h2>
            <div class="row g-3 my-2">
                <div class="col-md-6">
                    <div class="panel-alt p-3 rounded" style="border:1px solid rgba(78,205,196,0.25);">
                        <h5 style="color:var(--color-teal);">Hero Attacks</h5>
                        <p style="font-size:0.9rem;margin:0;">
                            Each correct answer deals damage to the monster. Drain their HP to zero to claim victory, XP, and gold rewards!
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="panel-alt p-3 rounded" style="border:1px solid rgba(233,69,96,0.25);">
                        <h5 style="color:var(--color-accent);">Monster Counterattacks</h5>
                        <p style="font-size:0.9rem;margin:0;">
                            Wrong answers let the enemy strike you. If your HP drops to zero, you respawn safely at full health and can retry immediately!
                        </p>
                    </div>
                </div>
            </div>
            <p class="mt-3">
                Question difficulties range from <strong>Easy</strong> to <strong>Hard</strong>, awarding higher XP and Gold bonuses.
            </p>
        </div>
    }
    else if (_step == 4)
    {
        <div class="tutorial-step-card animate-fade-in-up">
            <h2>Challenge Types</h2>
            <p>Throughout your quest, questions come in three distinct formats:</p>
            <ul style="line-height:1.8;">
                <li><strong>Multiple Choice:</strong> Select the correct answer from options A, B, C, or D.</li>
                <li><strong>Predict Output:</strong> Read a C# code snippet and enter the exact output printed to the console.</li>
                <li><strong>Write Code:</strong> Write and compile real C# code in the integrated code editor!</li>
            </ul>
            <div class="tutorial-callout">
                <strong>Tip:</strong> Re-reading completed lessons never has a penalty. You can always review past stories to refresh your memory.
            </div>
        </div>
    }
    else if (_step == 5)
    {
        <div class="tutorial-step-card animate-fade-in-up">
            <h2>Variables Valley Awaits!</h2>
            <p>
                You are ready to begin your journey. Start with <strong>Lesson 1: The Storage Chests</strong> in Variables Valley, read the lore and code examples, and conquer your first slime!
            </p>
            <div class="mb-3">
                <span class="difficulty-badge badge-easy">Tier 1: Valley Slime</span>
                <span class="difficulty-badge badge-medium">Tier 2: Data Goblin</span>
                <span class="difficulty-badge badge-hard">Boss: Variable Dragon</span>
            </div>
            <div class="p-3 my-3 rounded" style="background:rgba(245,166,35,0.1);border:1px solid rgba(245,166,35,0.3);">
                <p style="margin:0;color:var(--color-gold);font-weight:600;">
                    Ready, Hero? Click below to enter the World Map and claim your destiny!
                </p>
            </div>
        </div>
    }

    <!-- Controls Bar -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,0.08);">
        @if (_step > 1)
        {
            <button type="button" class="btn-secondary-fantasy" @onclick="Back">
                &larr; Back
            </button>
        }
        else
        {
            <span></span>
        }

        <div class="d-flex gap-1 align-items-center">
            @for (int i = 1; i <= TotalSteps; i++)
            {
                var stepNum = i;
                <span class="cq-step-dot"
                      style="display:inline-block;width:10px;height:10px;border-radius:50%;background:@(_step == stepNum ? "var(--color-accent)" : "rgba(255,255,255,0.15)");margin:0 3px;cursor:pointer;"
                      @onclick="() => SetStep(stepNum)"></span>
            }
        </div>

        <div>
            @if (_step < TotalSteps)
            {
                <button type="button" class="btn-fantasy" @onclick="Next">
                    Next &rarr;
                </button>
            }
            else
            {
                <button type="button" class="btn-fantasy" @onclick="FinishTutorial" disabled="@_saving">
                    @(_saving ? "Entering Map..." : "Start Your Quest!")
                </button>
            }
        </div>
    </div>

    <div class="text-center mt-3">
        <a href="/map?skip=1" @onclick="FinishTutorial" class="text-muted" style="font-size:0.85rem;text-decoration:underline;">
            Skip tutorial and enter World Map &rarr;
        </a>
    </div>
</div>

@code {
    private int _step = 1;
    private const int TotalSteps = 5;
    private Player? _player;
    private bool _saving = false;

    private void Next()
    {
        if (_step < TotalSteps)
        {
            _step++;
            StateHasChanged();
        }
    }

    private void Back()
    {
        if (_step > 1)
        {
            _step--;
            StateHasChanged();
        }
    }

    private void SetStep(int s)
    {
        if (s >= 1 && s <= TotalSteps)
        {
            _step = s;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _player = await GameSvc.GetCurrentPlayerAsync();
    }

    private async Task FinishTutorial()
    {
        if (_saving) return;
        _saving = true;
        StateHasChanged();

        try
        {
            _player ??= await GameSvc.GetCurrentPlayerAsync();

            if (_player != null)
            {
                await GameSvc.CompleteTutorialAsync(_player.Id);
            }
        }
        catch
        {
            // Proceed to map even if already marked
        }
        finally
        {
            Nav.NavigateTo("/map", forceLoad: true);
        }
    }
}
