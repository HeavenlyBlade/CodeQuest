@page "/"
@using Microsoft.AspNetCore.Components.Authorization
<PageTitle>CodeQuest - Learn C# Through Adventure</PageTitle>
<div class="text-center py-5 animate-fade-in-up">
  <pre style="color:var(--color-accent);font-size:clamp(0.45rem,1.2vw,0.72rem);line-height:1.3;display:inline-block;text-align:left;font-family:'Consolas',monospace;overflow-x:auto;">
  ___         _     ___             _  
 / __|___  __| |___/ _ \ _  _ ___ __| |
| (__/ _ \/ _` / -_) (_) | || / -_|_-&lt; _|
 \___\___/\__,_\___|\__\_\_,_\___/__/\__|
  </pre>
  <p style="color:var(--color-muted);font-size:1.1rem;margin-top:0.5rem;">Learn C# by going on an adventure</p>
</div>
<div class="row g-4 mb-4">
  <div class="col-md-4"><div class="panel text-center animate-fade-in-up" style="animation-delay:0.1s"><div style="font-size:2.5rem;">&#x1F4DC;</div><h4>Story-Based Lessons</h4><p class="muted-text">Every concept taught through an adventure story. No boring textbooks.</p></div></div>
  <div class="col-md-4"><div class="panel text-center animate-fade-in-up" style="animation-delay:0.2s"><div style="font-size:2.5rem;">&#x2694;&#xFE0F;</div><h4>Battle Monsters</h4><p class="muted-text">Answer coding questions to deal damage. Wrong answers hurt you. Learn by doing.</p></div></div>
  <div class="col-md-4"><div class="panel text-center animate-fade-in-up" style="animation-delay:0.3s"><div style="font-size:2.5rem;">&#x1F3C6;</div><h4>Level Up</h4><p class="muted-text">Earn XP and Gold. Climb the leaderboard. Defeat the boss to unlock the next zone.</p></div></div>
</div>
<div class="text-center mt-2">
  <AuthorizeView>
    <Authorized><a href="/map" class="btn-fantasy" style="font-size:1.05rem;padding:0.65rem 2rem;">&#x2694;&#xFE0F; Continue Quest</a></Authorized>
    <NotAuthorized>
      <a href="/register" class="btn-fantasy" style="font-size:1.05rem;padding:0.65rem 2rem;">Begin Adventure</a>
      <a href="/login" class="btn-secondary-fantasy ms-3" style="font-size:0.95rem;padding:0.6rem 1.5rem;">Login</a>
    </NotAuthorized>
  </AuthorizeView>
</div>
