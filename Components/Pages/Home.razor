@page "/"
@using CodeQuest.Components.Layout
@layout HomeLayout

<PageTitle>CodeQuest &#8212; Learn C# Through Adventure</PageTitle>

@* Hero section *@
<div class="text-center py-5 animate-fade-in-up">

    <div class="home-ascii-wrap">
        <pre class="home-ascii"> ____          _       ___                  _
/ ___|___   __| | ___ / _ \ _   _  ___  ___| |_
| |   / _ \ / _` |/ _ \ | | | | | |/ _ \/ __| __|
| |__| (_) | (_| |  __/ |_| | |_| |  __/\__ \ |_
 \____\___/ \__,_|\___|\__\_\\__,_|\___||___/\__|</pre>
    </div>

    <p class="home-tagline">Learn C# by going on an adventure</p>

    <div class="mt-4">
        <a href="/register" class="btn-fantasy" style="font-size:1.1rem;padding:0.7rem 2.2rem;">
            Begin Adventure
        </a>
    </div>
</div>

@* Feature cards *@
<div class="row g-4 mt-2 align-items-stretch">
    <div class="col-md-4 d-flex">
        <div class="panel text-center animate-fade-in-up h-100 w-100" style="animation-delay:0.1s">
            <div class="home-card-icon">&#x1F4DC;</div>
            <h4>Story-Based Lessons</h4>
            <p class="muted-text">Every concept is taught through an adventure story. No boring textbooks.</p>
        </div>
    </div>
    <div class="col-md-4 d-flex">
        <div class="panel text-center animate-fade-in-up h-100 w-100" style="animation-delay:0.2s">
            <div class="home-card-icon">&#x2694;&#xFE0F;</div>
            <h4>Battle Monsters</h4>
            <p class="muted-text">Answer coding questions to deal damage. Wrong answers hurt you. Learn by doing.</p>
        </div>
    </div>
    <div class="col-md-4 d-flex">
        <div class="panel text-center animate-fade-in-up h-100 w-100" style="animation-delay:0.3s">
            <div class="home-card-icon">&#x1F3C6;</div>
            <h4>Level Up</h4>
            <p class="muted-text">Earn XP and Gold. Climb the leaderboard. Defeat the boss to unlock the next zone.</p>
        </div>
    </div>
</div>
