@page "/leaderboard"
@rendermode InteractiveServer
@using CodeQuest.Data
@inject GameDbContext Db
@using Microsoft.EntityFrameworkCore

<PageTitle>Leaderboard – CodeQuest</PageTitle>

<div class="panel">
    <h2>🏆 Leaderboard</h2>
    <p class="muted-text mb-3">Top 10 heroes ranked by level and experience</p>

    @if (_loading)
    {
        <p>Loading...</p>
    }
    else if (!_players.Any())
    {
        <p>No heroes yet. Be the first!</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-dark table-striped mt-3">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Hero</th>
                    <th>Level</th>
                    <th>XP</th>
                    <th>Gold</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _players.Count; i++)
                {
                    var p = _players[i];
                    int rank = i + 1;
                    <tr>
                        <td>
                            @if (rank == 1) { <span class="rank-gold">&#x1F947;</span> }
                            else if (rank == 2) { <span class="rank-silver">&#x1F948;</span> }
                            else if (rank == 3) { <span class="rank-bronze">&#x1F949;</span> }
                            else { @rank }
                        </td>
                        <td>@p.HeroName</td>
                        <td>@p.Level</td>
                        <td>@p.Xp</td>
                        <td class="gold-text">@p.Gold 🪙</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    <a href="/map" class="btn btn-outline-secondary mt-3">← Back to Map</a>
</div>

@code {
    private List<Player> _players = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _players = await Db.Players
            .OrderByDescending(p => p.Level)
            .ThenByDescending(p => p.Xp)
            .Take(10)
            .ToListAsync();
        _loading = false;
    }
}
