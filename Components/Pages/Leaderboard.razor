@page "/leaderboard"
@rendermode InteractiveServer
@using CodeQuest.Data
@inject GameDbContext Db
@using Microsoft.EntityFrameworkCore

<PageTitle>Leaderboard – CodeQuest</PageTitle>

<div class="panel animate-fade-in-up">
    <h2>Hall of Heroes</h2>
    <p class="muted-text mb-3">Ranked by level, experience, and battle speed</p>

    @if (_loading)
    {
        <p>Loading leaderboard...</p>
    }
    else if (!_entries.Any())
    {
        <p>No heroes yet. Be the first to conquer the realm!</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-dark table-striped mt-3">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Hero</th>
                    <th>Level</th>
                    <th>XP</th>
                    <th>Gold</th>
                    <th>Battles Won</th>
                    <th>Fastest Clear</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>
                            @if (entry.Rank == 1) { <span class="rank-gold">1 👑</span> }
                            else if (entry.Rank == 2) { <span class="rank-silver">2 🥈</span> }
                            else if (entry.Rank == 3) { <span class="rank-bronze">3 🥉</span> }
                            else { @entry.Rank }
                        </td>
                        <td><strong>@entry.HeroName</strong></td>
                        <td>Lv. @entry.Level</td>
                        <td>@entry.Xp XP</td>
                        <td class="gold-text">@entry.Gold gold</td>
                        <td>@entry.BattlesWon ⚔️</td>
                        <td style="color:var(--color-teal);font-family:monospace;">@entry.FastestClear</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    <a href="/map" class="btn btn-outline-secondary mt-3">← Back to Map</a>
</div>

@code {
    private record LeaderboardEntry(
        int Rank,
        string HeroName,
        int Level,
        int Xp,
        int Gold,
        int BattlesWon,
        string FastestClear
    );

    private List<LeaderboardEntry> _entries = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var topPlayers = await Db.Players
            .OrderByDescending(p => p.Level)
            .ThenByDescending(p => p.Xp)
            .Take(10)
            .ToListAsync();

        var playerIds = topPlayers.Select(p => p.Id).ToList();

        var wonBattles = await Db.Battles
            .Where(b => playerIds.Contains(b.PlayerId) && b.Status == BattleStatus.Won && b.Attempts.Any())
            .Select(b => new {
                b.PlayerId,
                b.StartedAt,
                FinishedAt = b.Attempts.Max(a => a.AttemptedAt)
            })
            .ToListAsync();

        _entries = new();
        for (int i = 0; i < topPlayers.Count; i++)
        {
            var p = topPlayers[i];
            var pBattles = wonBattles.Where(b => b.PlayerId == p.Id).ToList();
            int wonCount = pBattles.Count;
            string fastest = "--";
            if (wonCount > 0)
            {
                var shortest = pBattles.Min(b => Math.Max(1, (int)(b.FinishedAt - b.StartedAt).TotalSeconds));
                fastest = $"{shortest}s";
            }
            _entries.Add(new LeaderboardEntry(i + 1, p.HeroName, p.Level, p.Xp, p.Gold, wonCount, fastest));
        }

        _loading = false;
    }
}
