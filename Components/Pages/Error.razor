@page "/Error"
@using System.Diagnostics

<PageTitle>Error – CodeQuest</PageTitle>

<div class="panel animate-fade-in-up text-center" style="max-width:600px;margin:3rem auto;">
    <div style="font-size:3rem;margin-bottom:1rem;">💀</div>
    <h2 style="font-family:var(--font-heading);color:var(--color-accent);">An Unhandled Exception Occurred</h2>
    <p class="muted-text">Something went wrong on our end. The error has been logged.</p>

    @if (ShowRequestId)
    {
        <p class="small text-muted mt-2">Request ID: <code>@RequestId</code></p>
    }

    <div class="d-flex gap-3 justify-content-center mt-4">
        <a href="/map" class="btn-fantasy">Return to World Map</a>
        <a href="/" class="btn-secondary-fantasy">Home</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
