@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/map">⚔️ CodeQuest</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/map" Match="NavLinkMatch.All">
                        🗺️ World Map
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/leaderboard">
                        🏆 Leaderboard
                    </NavLink>
                </div>
                <AuthorizeView Roles="Teacher" Context="teacherCtx">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/teacher/zones">📋 Zones</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/teacher/lessons">📖 Lessons</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/teacher/monsters">👾 Monsters</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/teacher/questions">❓ Questions</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/teacher/stats">📊 Stats</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-item px-3 mt-3">
                    <form method="post" action="/logout">
                        <input type="hidden" name="__RequestVerificationToken" value="" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Logout</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/login">Login</a>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/register">Register</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
