@inherits LayoutComponentBase
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="top-nav-tagline d-none d-md-flex align-items-center gap-2">
                <span style="font-size:1.1rem;">🛡️</span>
                <span style="font-family:var(--font-heading);font-size:0.85rem;color:var(--color-muted);letter-spacing:0.04em;">CodeQuest &#8212; Learn C# Through Adventure</span>
            </div>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge" style="background:rgba(233,69,96,0.15);color:var(--color-accent);border:1px solid rgba(233,69,96,0.3);font-size:0.75rem;">Hero</span>
                            <span style="font-size:0.85rem;color:var(--color-text);font-weight:600;">@context.User.Identity?.Name</span>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn-secondary-fantasy" style="padding:0.25rem 0.8rem;font-size:0.8rem;">Login</a>
                        <a href="/register" class="btn-fantasy" style="padding:0.25rem 0.8rem;font-size:0.8rem;">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>
